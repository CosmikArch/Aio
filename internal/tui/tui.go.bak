// Package tui provides an optional interactive terminal UI for play.
// It is launched either via "play tui" or automatically when play is invoked
// with no arguments inside an interactive terminal (TTY auto-detection).
package tui

import (
	"fmt"
	"os"
	"strings"

	tea "github.com/charmbracelet/bubbletea"
	"github.com/charmbracelet/lipgloss"

	"play/internal/config"
	"play/internal/player"
)

// ── Tab identifiers ───────────────────────────────────────────────────────────

type tabIndex int

const (
	tabFavorites tabIndex = iota
	tabHistory
	tabQueue
	numTabs = 3
)

var tabLabels = [numTabs]string{"⭐ Favorites", "🕰  History", "📋 Queue"}

// ── Data model ────────────────────────────────────────────────────────────────

// item carries both what is displayed and the raw query sent to the player.
// For favorites/queue these are identical. For history the display includes
// the timestamp ("2006-01-02 15:04 | title") while the query is title-only.
type item struct {
	display string
	query   string
}

type model struct {
	activeTab tabIndex
	lists     [numTabs][]item
	cursor    [numTabs]int
	width     int
	height    int
	message   string // ephemeral status shown in the help bar
}

// ── Styles ────────────────────────────────────────────────────────────────────

var (
	clrPurple    = lipgloss.Color("#7C3AED")
	clrDimGray   = lipgloss.Color("#6B7280")
	clrLightGray = lipgloss.Color("#D1D5DB")
	clrGreen     = lipgloss.Color("#10B981")
	clrWhite     = lipgloss.Color("#FFFFFF")

	titleStyle = lipgloss.NewStyle().
			Bold(true).
			Foreground(clrPurple)

	activeTabStyle = lipgloss.NewStyle().
			Bold(true).
			Foreground(clrWhite).
			Background(clrPurple).
			Padding(0, 1)

	inactiveTabStyle = lipgloss.NewStyle().
				Foreground(clrDimGray).
				Padding(0, 1)

	dividerStyle = lipgloss.NewStyle().
			Foreground(clrDimGray)

	cursorStyle = lipgloss.NewStyle().
			Foreground(clrPurple).
			Bold(true)

	normalStyle = lipgloss.NewStyle().
			Foreground(clrLightGray)

	dimStyle = lipgloss.NewStyle().
			Foreground(clrDimGray)

	helpStyle = lipgloss.NewStyle().
			Foreground(clrDimGray)

	messageStyle = lipgloss.NewStyle().
			Foreground(clrGreen).
			Bold(true)

	outerBorder = lipgloss.NewStyle().
			Border(lipgloss.RoundedBorder()).
			BorderForeground(clrDimGray).
			Padding(0, 1)
)

// ── File I/O helpers ──────────────────────────────────────────────────────────

func loadFavorites() []item {
	data, err := os.ReadFile(config.FavoritesFile)
	if err != nil {
		return nil
	}
	var items []item
	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
		if line != "" {
			items = append(items, item{display: line, query: line})
		}
	}
	return items
}

// loadHistory reads the log newest-first.
// Each line is "2006-01-02 15:04 | <YouTube title>"; we use the title as
// the query so cache.LookupEntry can resolve it to a cached file.
func loadHistory() []item {
	data, err := os.ReadFile(config.HistoryFile)
	if err != nil {
		return nil
	}
	lines := strings.Split(strings.TrimSpace(string(data)), "\n")
	var items []item
	for i := len(lines) - 1; i >= 0; i-- {
		line := lines[i]
		if line == "" {
			continue
		}
		query := line
		if idx := strings.Index(line, " | "); idx != -1 {
			query = line[idx+3:]
		}
		items = append(items, item{display: line, query: query})
	}
	return items
}

func loadQueue() []item {
	data, err := os.ReadFile(config.QueueFile)
	if err != nil {
		return nil
	}
	var items []item
	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
		if line != "" {
			items = append(items, item{display: line, query: line})
		}
	}
	return items
}

// writeLines persists a slice of query strings to a file (one per line).
func writeLines(path string, items []item) {
	var sb strings.Builder
	for _, it := range items {
		sb.WriteString(it.query)
		sb.WriteByte('\n')
	}
	os.WriteFile(path, []byte(sb.String()), 0644)
}

// ── Bubble Tea model ──────────────────────────────────────────────────────────

func InitialModel() model {
	m := model{}
	m.lists[tabFavorites] = loadFavorites()
	m.lists[tabHistory] = loadHistory()
	m.lists[tabQueue] = loadQueue()
	return m
}

func (m model) Init() tea.Cmd { return nil }

func (m model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {

	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height

	case tea.KeyMsg:
		switch msg.String() {

		// ── Quit ─────────────────────────────────────────────────────────
		case "ctrl+c", "q":
			return m, tea.Quit

		// ── Tab switching ─────────────────────────────────────────────────
		case "tab", "right", "l":
			m.activeTab = (m.activeTab + 1) % numTabs
			m.message = ""
		case "shift+tab", "left", "h":
			m.activeTab = (m.activeTab + numTabs - 1) % numTabs
			m.message = ""
		case "1":
			m.activeTab = tabFavorites
			m.message = ""
		case "2":
			m.activeTab = tabHistory
			m.message = ""
		case "3":
			m.activeTab = tabQueue
			m.message = ""

		// ── Navigation ───────────────────────────────────────────────────
		case "up", "k":
			if m.cursor[m.activeTab] > 0 {
				m.cursor[m.activeTab]--
			}
		case "down", "j":
			if m.cursor[m.activeTab] < len(m.lists[m.activeTab])-1 {
				m.cursor[m.activeTab]++
			}

		// ── Play selected item ────────────────────────────────────────────
		case "enter":
			items := m.lists[m.activeTab]
			if len(items) == 0 {
				break
			}
			selected := items[m.cursor[m.activeTab]]
			player.PlayNew(selected.query, false)
			m.message = "▶  " + selected.query

		// ── Delete (favorites and queue only; history is read-only) ───────
		case "d":
			if m.activeTab == tabHistory {
				m.message = "History is read-only."
				break
			}
			items := m.lists[m.activeTab]
			if len(items) == 0 {
				break
			}
			i := m.cursor[m.activeTab]
			m.lists[m.activeTab] = append(items[:i:i], items[i+1:]...)
			if i > 0 && i >= len(m.lists[m.activeTab]) {
				m.cursor[m.activeTab]--
			}
			switch m.activeTab {
			case tabFavorites:
				writeLines(config.FavoritesFile, m.lists[tabFavorites])
			case tabQueue:
				writeLines(config.QueueFile, m.lists[tabQueue])
			}
			m.message = "Removed."

		// ── Reload all lists from disk (e.g. after queuing externally) ───
		case "r":
			m.lists[tabFavorites] = loadFavorites()
			m.lists[tabHistory] = loadHistory()
			m.lists[tabQueue] = loadQueue()
			for t := range m.cursor {
				if m.cursor[t] >= len(m.lists[t]) && m.cursor[t] > 0 {
					m.cursor[t] = len(m.lists[t]) - 1
				}
			}
			m.message = "Refreshed."
		}
	}
	return m, nil
}

func (m model) View() string {
	// Inner content width (subtract border 2 + padding 2).
	innerW := m.width - 4
	if innerW < 40 {
		innerW = 40
	}

	// ── Title ─────────────────────────────────────────────────────────────
	title := titleStyle.Render("🎵 play")

	// ── Tab bar ───────────────────────────────────────────────────────────
	var tabBar strings.Builder
	for i := 0; i < numTabs; i++ {
		label := fmt.Sprintf("%d %s", i+1, tabLabels[i])
		if tabIndex(i) == m.activeTab {
			tabBar.WriteString(activeTabStyle.Render(label))
		} else {
			tabBar.WriteString(inactiveTabStyle.Render(label))
		}
		if i < numTabs-1 {
			tabBar.WriteString("  ")
		}
	}
	divider := dividerStyle.Render(strings.Repeat("─", innerW))

	// ── List ──────────────────────────────────────────────────────────────
	items := m.lists[m.activeTab]
	cursor := m.cursor[m.activeTab]

	var listBuf strings.Builder
	if len(items) == 0 {
		listBuf.WriteString(dimStyle.Render("  (empty)"))
	} else {
		// Reserve enough lines for border, title, tabs, divider, help, message.
		visibleLines := m.height - 11
		if visibleLines < 5 {
			visibleLines = 5
		}
		if visibleLines > len(items) {
			visibleLines = len(items)
		}

		// Scroll window: keep cursor in view.
		start := 0
		if cursor >= visibleLines {
			start = cursor - visibleLines + 1
		}
		end := start + visibleLines

		if start > 0 {
			listBuf.WriteString(dimStyle.Render(fmt.Sprintf("  ↑ %d more above\n", start)))
		}
		for i := start; i < end && i < len(items); i++ {
			line := items[i].display
			// Truncate long lines to fit the panel.
			maxLen := innerW - 4
			if len([]rune(line)) > maxLen {
				line = string([]rune(line)[:maxLen-1]) + "…"
			}
			if i == cursor {
				listBuf.WriteString(cursorStyle.Render("▶ " + line))
			} else {
				listBuf.WriteString(normalStyle.Render("  " + line))
			}
			if i < end-1 && i < len(items)-1 {
				listBuf.WriteString("\n")
			}
		}
		remaining := len(items) - end
		if remaining > 0 {
			listBuf.WriteString("\n" + dimStyle.Render(fmt.Sprintf("  ↓ %d more below", remaining)))
		}
	}

	// ── Status / help bar ─────────────────────────────────────────────────
	var statusLine string
	if m.message != "" {
		statusLine = messageStyle.Render(m.message)
	} else {
		parts := []string{
			"↑/↓ navigate",
			"enter play",
			"d delete",
			"r refresh",
			"tab switch",
			"q quit",
		}
		statusLine = helpStyle.Render(strings.Join(parts, "  ·  "))
	}

	body := fmt.Sprintf("%s\n\n%s\n%s\n\n%s\n\n%s",
		title,
		tabBar.String(),
		divider,
		listBuf.String(),
		statusLine,
	)

	if m.width > 0 {
		return outerBorder.Width(innerW).Render(body)
	}
	return outerBorder.Render(body)
}

// Run starts the Bubble Tea program in full-screen (alt-screen) mode.
// The caller's terminal is restored cleanly on exit.
func Run() error {
	p := tea.NewProgram(InitialModel(), tea.WithAltScreen())
	_, err := p.Run()
	return err
}
